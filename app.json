{
  "expo": {
    "name": "Focus",
    "slug": "focus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Logo.png",
    "scheme": "focusapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./Logo.png",
      "bundleIdentifier": "com.focus.dominant",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08080C",
        "foregroundImage": "./Logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080C",
          "image": "./Logo.png",
          "imageWidth": 180
        }
      ],
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "989a1693-5706-4f4b-bf30-e1d21bc2c0a7"
      }
    }
  }
}
